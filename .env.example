# Copie para .env e preencha. O .env não vai para o Git.

# Banco do sistema novo (formato SQLAlchemy). Sem esta linha, a API usa um
# SQLite local (api/piki-dev.db), bom para desenvolver sem servidor de banco.
#   MariaDB:    mysql+pymysql://usuario:senha@localhost:3306/piki?charset=utf8mb4
#   PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/piki
# PIKI_DATABASE_URL=

# Ambiente: dev ou producao
PIKI_AMBIENTE=dev

# Chave para assinar os tokens de login. Obrigatória em produção.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PIKI_SEGREDO_TOKEN=

# Validade do login, em minutos (600 = 10 horas)
PIKI_MINUTOS_TOKEN=600
