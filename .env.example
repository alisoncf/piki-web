# Copie para .env e preencha. O .env não vai para o Git.

# Conexão com o MariaDB (formato SQLAlchemy)
PIKI_DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/requinte?charset=utf8mb4

# Filial padrão quando a requisição não informar outra
PIKI_COD_EMP_PADRAO=01

# Ambiente: dev ou producao
PIKI_AMBIENTE=dev
