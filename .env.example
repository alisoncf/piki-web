# Copie para .env e preencha. O .env não vai para o Git.

# Porta do PostgreSQL do docker-compose no seu computador. Se mudar, ajuste as URLs abaixo.
PIKI_PORTA_BANCO=5433

# Banco do sistema novo (PostgreSQL, decisão D12).
# Este valor funciona com o docker-compose.yml do projeto.
PIKI_DATABASE_URL=postgresql+psycopg://piki:piki@localhost:5433/piki

# Banco usado pelos testes (opcional). Sem ele, os testes usam SQLite em memória.
# PIKI_TESTE_DATABASE_URL=postgresql+psycopg://piki:piki@localhost:5433/piki_teste

# Ambiente: dev ou producao
PIKI_AMBIENTE=dev

# Chave para assinar os tokens de login. Obrigatória em produção.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PIKI_SEGREDO_TOKEN=

# Validade do login, em minutos (600 = 10 horas)
PIKI_MINUTOS_TOKEN=600

# Consulta de CEP (opcionais; padrão: ViaCEP, 5 segundos)
# PIKI_VIACEP_URL=https://viacep.com.br/ws/{cep}/json/
# PIKI_VIACEP_SEGUNDOS=5
